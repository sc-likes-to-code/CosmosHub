# ── Server Config ──
PORT=3001

# ── Gemini AI Configuration (Server-Side Only) ──
# Google AI Studio API Key (Never expose to frontend, never prefix with VITE_)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Daily automatic summary budget limit (10-15 recommended for quota conservation)
AI_DAILY_SUMMARY_LIMIT=15
AI_SUMMARIZATION_ENABLED=true

# ── Feed Volume (Optional) ──
# Max feed items fetched per source (default: 50)
VITE_RSS_MAX_PER_SOURCE=50
