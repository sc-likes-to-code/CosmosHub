# ── Server Config ──
PORT=3001

# ── Gemini AI Configuration (Server-Side Only) ──
# Google AI Studio API Key (Never expose to frontend, never prefix with VITE_)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Daily automatic summary budget limit (10-15 recommended for quota conservation)
AI_DAILY_SUMMARY_LIMIT=15
AI_SUMMARIZATION_ENABLED=true

# ── Upstash Redis Configuration (Server-Side Only) ──
# Option 1: Vercel Marketplace Upstash Integration (Automatically generated in Vercel):
UPSTASH_REDIS_REST_KV_REST_API_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=your_upstash_rest_token_here
# Note: Do NOT use UPSTASH_REDIS_REST_KV_REST_API_READ_ONLY_TOKEN as the write token.
# Note: UPSTASH_REDIS_REST_REDIS_URL is for TCP Redis, not the REST API client.

# Option 2: Local Development / Manual Upstash Configuration (Supported as fallbacks):
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── Feed Volume (Optional) ──
# Max feed items fetched per source (default: 50)
VITE_RSS_MAX_PER_SOURCE=50
